# Copy this file to .env and fill in your values. .env is gitignored.
# Only the example agents in examples/ read these. The loopview server itself
# needs no keys.

# Anthropic API key, used by every example agent and the live flagship demo.
ANTHROPIC_API_KEY=

# Model used by the examples. Haiku is the cheapest option for capturing fixtures.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Where the examples send their traces (a running `loopview`).
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Export finished spans every 100 ms instead of the default 5 s, so the graph
# updates smoothly while the agent runs.
OTEL_BSP_SCHEDULE_DELAY=100
